{
  "name": "@repo/map",
  "version": "1.0.0",
  "private": true,
  "description": "Shared map components, Apollo Client hooks, and GraphQL queries for Uber Clone",
  "exports": {
    "./components/*": "./dist/components/*.js",
    "./store/*": "./dist/store/*.js",
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsc && tailwindcss -i ./src/styles.css -o ./dist/index.css ",
    "dev": "concurrently \"tsc --watch\" \"tailwindcss -i ./src/styles.css -o ./dist/index.css --watch\"",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/google.maps": "^3.66.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.61.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "zustand": "^5.0.16"
  }
}